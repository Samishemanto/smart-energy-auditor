# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include: http://127.0.0.1:8000/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── App URLs ─────────────────────────────────────────────────────────────────
STREAMLIT_URL=http://localhost:8501

# ─── Admin ────────────────────────────────────────────────────────────────────
# The Google account email that gets admin privileges on first login
ADMIN_EMAIL=your-email@gmail.com

# ─── OCR paths (Windows only — leave blank if tesseract is on PATH) ───────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\path\to\poppler\Library\bin
